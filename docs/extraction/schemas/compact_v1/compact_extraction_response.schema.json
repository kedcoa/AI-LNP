    "EligibilityRecord": {
      "additionalProperties": false,
      "description": "Evidence-grounded final paper disposition for the extraction task.",
      "properties": {
        "decision": {
          "enum": [
            "eligible",
            "ineligible",
            "uncertain"
          ],
          "title": "Decision",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "enum": [
              "ORIGINAL_EXPERIMENT",
              "IDENTIFIABLE_LNP",
              "SUPPORTED_PAYLOAD",
              "TARGET_CELL_EVIDENCE",
              "USABLE_FORMULATION_OUTCOME_LINKAGE",
              "NOT_ORIGINAL_RESEARCH",
              "NOT_ELIGIBLE_LNP",
              "UNSUPPORTED_PAYLOAD",
              "NO_TARGET_CELL_EVIDENCE",
              "NO_FORMULATION_OUTCOME_LINKAGE",
              "DUPLICATE_SCIENTIFIC_REPORT",
              "RETRACTED_OR_INVALID",
              "FULL_TEXT_REQUIRED",
              "PUBLICATION_TYPE_AMBIGUOUS",
              "LNP_IDENTITY_AMBIGUOUS",
              "PAYLOAD_AMBIGUOUS",
              "TARGET_CELL_AMBIGUOUS",
              "FORMULATION_INCOMPLETE",
              "OUTCOME_LINKAGE_AMBIGUOUS",
              "CHEMISTRY_AMBIGUOUS"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "decision",
        "reason_codes",
        "explanation"
      ],
      "title": "EligibilityRecord",
      "type": "object"
    },
