      }
    },
    {
      "evidence_id": "GP-008-FC-d17010e8cbba6cec",
      "text": "(G and H) Flow cytometry analysis of CD80 and CD206 expression in the screened BMDMs and the analysis.",
      "source_ids": [
        "FC-S-b1303c7efd61ae31"
      ],
