      }
    },
    {
      "evidence_id": "GP-008-FC-83007ec4ceee1251",
      "text": "S12G) confirmed elevated frequencies of CCR2+/MMP12+/MMP13+/IL-6+ subsets, with particularly pronounced enrichment of MMP12+ macrophages, alongside reduced MKI67+/CD9+ populations relative to fibrotic controls (Fig.",
      "source_ids": [
        "FC-S-a6f2290dacffb34f"
      ],
      "source_kind": "text",
      "provenance": {
