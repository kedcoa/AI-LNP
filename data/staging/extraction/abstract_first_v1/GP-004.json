  "evidence": [
    {
      "evidence_id": "AF-GP-004-Evidence1",
      "paper_id": "GP-004",
      "evidence_text": "Here, we establish an efficient, safe, non-integrative method to transiently express hepatocyte-growth-factor (HGF) and epidermal-growth-factor (EGF) in hepatocytes via nucleoside-modified, lipid-nanoparticle-encapsulated mRNA (mRNA-LNP) delivery in mice. We confirm specific hepatotropism of mRNA-LNP via intravenous injection of firefly luciferase encoding mRNA-LNP, with protein expression lasting about 3 days.",
      "evidence_location_type": "abstract",
      "section_name": null,
      "page_number": null,
      "table_number": null,
      "figure_number": null,
      "supplement_identifier": null,
      "extraction_method": "manual",
      "extraction_confidence": "high"
    },
    {
      "evidence_id": "AF-GP-004-Evidence2",
      "paper_id": "GP-004",
      "evidence_text": "In the liver, virtually all hepatocytes are transfected along with a subpopulation of endothelial and Kupffer cells.",
      "evidence_location_type": "abstract",
      "section_name": null,
      "page_number": null,
      "table_number": null,
      "figure_number": null,
      "supplement_identifier": null,
      "extraction_method": "manual",
      "extraction_confidence": "high"
    },
    {
      "evidence_id": "AF-GP-004-Evidence3",
      "paper_id": "GP-004",
      "evidence_text": "In a chronic liver injury mouse model recapitulating non-alcoholic fatty liver disease, injections of both HGF and EGF mRNA-LNP sharply reverse steatosis and accelerate restoration of liver function. Likewise, HGF and EGF mRNA-LNP accelerate liver regeneration after acetaminophen-induced acute liver injury with rapid return to baseline ALT levels.",
      "evidence_location_type": "abstract",
      "section_name": null,
      "page_number": null,
      "table_number": null,
      "figure_number": null,
      "supplement_identifier": null,
