  "evidence": [
    {
      "evidence_id": "GP-006-FC-e47e445580c98e0f",
      "text": "The results indicated that high levels of luciferase expression were obtained from both hepatocytes and LSECs with about 17-fold higher expression in hepatocytes than LSECs.",
