  "evidence": [
    {
      "evidence_id": "GP-008-FC-1dc71dae4927710a",
      "text": "In the Fibrosis group, PCNA expression was significantly increased in HSCs\nPCNA expression was almost absent in Heps",
      "source_ids": [
        "FC-S-9a8b8f55dd34f16d"
      ]
    },
    {
      "evidence_id": "GP-008-FC-a5f4eb9b5d252ba0",
      "text": "Notably, the αCD163/LNP-FAPCAR cohort achieved the most pronounced fibrosis regression.",
      "source_ids": [
        "FC-S-b842c4f3d32bf804"
      ]
    },
    {
      "evidence_id": "GP-008-FC-e75218514098ec17",
      "text": "The results demonstrated that, compared with HSCs induced solely by TGF-β1, HSCs exposed to MMP12+macrophage-conditioned medium (CM) expressed fewer fibrosis-related proteins and mRNAs (Fig.",
      "source_ids": [
        "FC-S-a6f2290dacffb34f"
      ]
    },
    {
      "evidence_id": "GP-008-FC-00a892f506ee3803",
      "text": "Given negligible SPP1 expression across all clusters, the analyzed macrophage landscape was predominantly enriched for SAM-like states.",
      "source_ids": [
        "FC-S-a6f2290dacffb34f"
      ]
    },
    {
      "evidence_id": "GP-008-FC-83007ec4ceee1251",
      "text": "S12G) confirmed elevated frequencies of CCR2+/MMP12+/MMP13+/IL-6+ subsets, with particularly pronounced enrichment of MMP12+ macrophages, alongside reduced MKI67+/CD9+ populations relative to fibrotic controls (Fig.",
      "source_ids": [
        "FC-S-a6f2290dacffb34f"
      ]
    },
    {
      "evidence_id": "GP-008-FC-730aaa4eea997e6f",
      "text": "We found that the LNP group had a lower proportion of HSCs than the Fibrosis group.",
      "source_ids": [
        "FC-S-9a8b8f55dd34f16d"
      ]
    },
    {
      "evidence_id": "GP-008-FC-028bd91acc9c0900",
      "text": "We found that more Heps (ALB+) in the LNP group expressed PCNA\nHSCs (Desmin+) showed almost no PCNA expression.",
      "source_ids": [
        "FC-S-9a8b8f55dd34f16d"
      ]
    }
  ],
