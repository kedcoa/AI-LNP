          "text": "{\"contract_version\":\"compact-1.1.0\",\"paper_id\":\"NP-001\",\"eligibility\":{\"decision\":\"eligible\",\"reason_codes\":[\"ORIGINAL_EXPERIMENT\",\"IDENTIFIABLE_LNP\",\"SUPPORTED_PAYLOAD\",\"TARGET_CELL_EVIDENCE\",\"USABLE_FORMULATION_OUTCOME_LINKAGE\"],\"evidence_ids\":[\"NP-001-E-f0dbf2460867f112\",\"NP-001-E-7b3c625323c08b9c\",\"NP-001-E-692db6bd61bb5c3e\"],\"explanation\":\"The packet reports in-vitro evaluation of EGFP mRNA encapsulated in LNP formulations in DC2.4 cells, with a DC2.4 transfection comparison between LNP and LNP/DX25.\"},\"formulations\":[{\"formulation_id\":\"F1\",\"formulation_name\":{\"value\":\"LNP\",\"status\":\"reported\",\"evidence_ids\":[\"NP-001-E-692db6bd61bb5c3e\"],\"missing_reason\":null},\"composition\":{\"value\":\"ALC-0315; DSPC or DOPE; cholesterol or DX; ALC-0159\",\"status\":\"reported\",\"evidence_ids\":[\"NP-001-E-f0dbf2460867f112\"],\"missing_reason\":null},\"composition_basis\":{\"value\":\"Theoretical composition estimated from the precise mass of individual components added to the ethanolic phase\",\"status\":\"reported\",\"evidence_ids\":[\"NP-001-E-f0dbf2460867f112\"],\"missing_reason\":null},\"np_ratio\":{\"value\":null,\"status\":\"missing\",\"evidence_ids\":[],\"missing_reason\":\"Not reported in the supplied evidence packet.\"}}],\"components\":[],\"experiments\":[{\"experiment_id\":\"EXP1\",\"formulation_id\":\"F1\",\"payload_type\":{\"value\":\"mRNA\",\"status\":\"reported\",\"evidence_ids\":[\"NP-001-E-7b3c625323c08b9c\"],\"missing_reason\":null},\"payload_name\":{\"value\":\"EGFP-encoding mRNA\",\"status\":\"reported\",\"evidence_ids\":[\"NP-001-E-7b3c625323c08b9c\"],\"missing_reason\":null},\"encoded_product\":{\"value\":\"EGFP\",\"status\":\"reported\",\"evidence_ids\":[\"NP-001-E-7b3c625323c08b9c\"],\"missing_reason\":null},\"molecular_target\":{\"value\":null,\"status\":\"missing\",\"evidence_ids\":[],\"missing_reason\":\"No molecular target was reported in the supplied evidence packet.